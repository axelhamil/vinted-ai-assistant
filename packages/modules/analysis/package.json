{
  "name": "@packages/analysis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./analysis.module": "./src/analysis.module.ts",
    "./contract": "./src/contract.ts",
    "./schemas/*": "./schemas/*.ts",
    "./domain/*": "./src/domain/*.ts",
    "./application/*": "./src/application/*.ts",
    "./infrastructure/*": "./src/infrastructure/*.ts",
    "./testing/*": "./src/testing/*.ts"
  },
  "scripts": {
    "type-check": "tsc7 -v && tsc7 --noEmit",
    "test": "bun --config=../../../bunfig.toml test",
    "test:db": "bun ../../testing/src/global-setup.ts && bun --config=../../../bunfig.db.toml test --isolate --timeout=15000 .db.test.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@packages/ai": "workspace:*",
    "@packages/ddd-kit": "workspace:*",
    "@packages/drizzle": "workspace:*",
    "@packages/outbox": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "inwire": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@packages/testing": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@types/bun": "^1.4.4",
    "typescript": "~6.0.3"
  }
}
