{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "packages/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ai": {
      "entry": ["src/**/*.test.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/modules/*": {
      "entry": [
        "schemas/*.ts",
        "src/*.module.ts",
        "src/testing/*.ts",
        "src/**/*.test.ts"
      ],
      "project": ["schemas/**/*.ts", "src/**/*.ts"]
    },
    "apps/api": {
      "entry": ["src/index.ts", "common/**/*.test.ts", "src/**/*.test.ts"],
      "project": ["common/**/*.ts", "src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/extension": {
      "entry": [
        "entrypoints/**",
        "**/*.test.ts",
        "components/ui/*.tsx",
        "assets/styles.css"
      ]
    }
  },
  "ignoreWorkspaces": ["apps/backend", "packages/shared", "installer"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "unlisted": "off",
    "unresolved": "off",
    "optionalPeerDependencies": "off",
    "exports": "warn",
    "types": "warn",
    "duplicates": "off"
  }
}
