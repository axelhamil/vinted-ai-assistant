    "@packages/outbox": "workspace:*",
    "@packages/studio": "workspace:*",
    "@sentry/bun": "^11.8.0",
    "dotenv": "^18.0.8",
    "hono": "^4.13.14",
    "hono-pino": "^0.10.3",
    "inwire": "^4.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@packages/testing": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
