{
  "extends": "./packages/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "incremental": false,
    "allowJs": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "dist", ".cache"]
}
